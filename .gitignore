# Every local env file. `vercel env pull` writes .env.local by default, which
# holds production secrets (DATABASE_URL, PAYLOAD_SECRET, S3 keys) — the bare
# `.env` pattern did not cover it. .env.example is checked in deliberately.
.env
.env.*
!.env.example
.next
next-env.d.ts
.vercel

# Payload default media upload directory
public/media/

public/robots.txt
public/sitemap*.xml


